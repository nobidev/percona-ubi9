# Percona Operator for MongoDB 1.23.1. Upstream image: UBI 10 (RHEL 10.2).
# Its Go binaries are static (CGO_ENABLED=0), but the image's own tools (bash
# for the entrypoint scripts copied into the database pods, ...) are RHEL 10.
# Rebuilt from upstream/percona-server-mongodb-operator/1.23.1 with BASE_IMAGE=ubi9.
# Note: the upstream image was built from 8dba20d5 (release-1-23-1); the tag
# v1.23.1 (a4367b91) only adds deploy/cr.yaml and e2e test changes on top,
# none of which is copied into the image.
MODE=build
UPSTREAM_REPO=https://github.com/percona/percona-server-mongodb-operator
UPSTREAM_REF=v1.23.1
UPSTREAM_IMAGE=docker.io/percona/percona-server-mongodb-operator:1.23.1
CONTROL_IMAGE=docker.io/percona/percona-server-mongodb-operator:1.23.1
DOCKERFILE=build/Dockerfile
PREPARE_CMD=
BINARIES=/usr/local/bin/percona-server-mongodb-operator /mongodb-healthcheck
SMOKE_CMDS=/usr/local/bin/percona-server-mongodb-operator --help;/mongodb-healthcheck --help
