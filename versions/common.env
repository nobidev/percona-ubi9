# Settings shared by every target. Per-target settings live in
# versions/<image>/<version>.env; TARGET=<image>/<version> selects one
# (scripts/lib.sh). Plain KEY=VALUE lines only: no quotes, no spaces around
# '=', no expansion. Anything here can be overridden from the environment or
# the make command line.

# Repository prefix that every image is pushed under:
# ${REGISTRY}/<image>:<version> and ${REGISTRY}/<image>:<version>-${TAG_SUFFIX}
REGISTRY=ghcr.io/nobidev/percona-ubi9
TAG_SUFFIX=ubi9

# Value of the upstream Dockerfiles' BASE_IMAGE build argument
# (registry.access.redhat.com/${BASE_IMAGE}/ubi-minimal). UBI 9 / RHEL 9 is
# built for x86-64-v2; UBI 10 / RHEL 10 needs x86-64-v3.
UBI_BASE_IMAGE=ubi9

# Only linux/amd64 is rebuilt: the CPU baseline problem is x86-64 specific.
PLATFORM=linux/amd64

# Source of the org.opencontainers.image.source label (links the GHCR package
# to this repository).
SOURCE_URL=https://github.com/nobidev/percona-ubi9

# ---------------------------------------------------------------------------
# Verification (scripts/verify-image.sh)
# ---------------------------------------------------------------------------
# /etc/redhat-release of every published image must match this (grep -E).
EXPECT_RELEASE=^Red Hat Enterprise Linux release 9[.]
# Highest GLIBC_x.y symbol version a dynamic binary may require (glibc of RHEL 9).
MAX_GLIBC=2.34
# CPU emulated by qemu-user: Intel Ivy Bridge (Xeon E5-26xx v2), x86-64-v2, no AVX2.
QEMU_CPU=IvyBridge
# Seconds each emulated command may run before it is stopped (counted as
# started, not as a failure).
SMOKE_TIMEOUT=60
# Commands run in every image rootfs, in addition to the target's SMOKE_CMDS
# (';'-separated, first word is the binary inside the image).
COMMON_SMOKE_CMDS=/usr/bin/bash -c true
# Control image: the same execution test must FAIL on it with
# "CPU does not support x86-64-v3", otherwise the test proves nothing. Targets
# rebuilt from source override it with their own UBI 10 upstream image.
CONTROL_IMAGE=docker.io/percona/percona-postgresql-operator:3.1.0

# ---------------------------------------------------------------------------
# OLM bundles and catalog (scripts/olm-*.sh, bundles/<package>/<version>.env)
# ---------------------------------------------------------------------------
# Where bundle and catalog images are pushed (empty: REGISTRY). Pull requests
# use a throwaway local registry; operator image references in the bundles
# always use REGISTRY.
OLM_REGISTRY=
# Upstream catalog the bundles, packages and channels come from: the
# community operator index that OKD 4.20 uses, pinned by digest.
UPSTREAM_INDEX=registry.access.redhat.com/redhat/community-operator-index:v4.20@sha256:d3ecc566d47fe277aaac3c0192534a4e46fac3d1695d1ff92c9d35d8246b5f18
# opm (operator-registry) image: renders and validates the catalog and is the
# base of the catalog image (static binaries, verified on x86-64-v2).
OPM_IMAGE=quay.io/operator-framework/opm:v1.74.0@sha256:b32d3891616662620da08d7f0ec42c2e69fa2de43427dc975d35b12f7a969a0f
# Catalog image: ${OLM_REGISTRY}/${CATALOG_NAME}:latest (what the
# CatalogSource polls) and an immutable :<date>-<content hash> tag.
CATALOG_NAME=catalog
