# Percona Operator for PostgreSQL 2.9.0. Upstream image: UBI 10 (RHEL 10),
# dies on x86-64-v2 with "Fatal glibc error: CPU does not support x86-64-v3".
# Rebuilt from upstream/percona-postgresql-operator/2.9.0 with BASE_IMAGE=ubi9.
# A step of the upgrade path 2.8.2 -> 2.9.0 -> 3.0.0 -> 3.1.0 (Percona
# supports upgrading only to the nearest version).
MODE=build
UPSTREAM_REPO=https://github.com/percona/percona-postgresql-operator
UPSTREAM_REF=v2.9.0
UPSTREAM_IMAGE=docker.io/percona/percona-postgresql-operator:2.9.0
CONTROL_IMAGE=docker.io/percona/percona-postgresql-operator:2.9.0
DOCKERFILE=build/postgres-operator/Dockerfile
# `make build` upstream runs get-pgmonitor first: the Dockerfile copies the
# pgMonitor queries from hack/tools/queries.
PREPARE_CMD=make get-pgmonitor
# Binaries checked for their GLIBC requirement (no pgbouncer-startup before 3.1.0).
BINARIES=/usr/local/bin/postgres-operator /usr/local/bin/extension-installer /usr/local/bin/pgbackrest
# postgres-operator and pgbackrest ignore --help and start until they find no
# kubeconfig.
SMOKE_CMDS=/usr/local/bin/postgres-operator --help;/usr/local/bin/extension-installer --help;/usr/local/bin/pgbackrest --help
