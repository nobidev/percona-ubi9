# Percona Operator for PostgreSQL 2.8.2. The upstream image is already UBI 9
# (RHEL 9.7) and runs on x86-64-v2, so it is copied unchanged (all platforms,
# same digest). It is needed next to 3.1.0: the operator runs the init
# container of a cluster whose crVersion differs from its own version from
# <operator image repository>:<crVersion> (percona/k8s/util.go InitImage).
MODE=copy
SOURCE_IMAGE=docker.io/percona/percona-postgresql-operator:2.8.2@sha256:c70926e7022da1ee3b885182f1b584e2835c9a0774485387efa658ca7bc93a1e
# 2.8.2 has no pgbouncer-startup (added in 3.1.0).
BINARIES=/usr/local/bin/postgres-operator /usr/local/bin/extension-installer /usr/local/bin/pgbackrest
SMOKE_CMDS=/usr/local/bin/postgres-operator --help;/usr/local/bin/extension-installer --help;/usr/local/bin/pgbackrest --help
