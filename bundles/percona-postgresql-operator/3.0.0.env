# Community catalog bundle of percona-postgresql-operator.v3.0.0, with the
# operator image (UBI 10 upstream) replaced by the UBI 9 rebuild.
MODE=rewrite
UPSTREAM_BUNDLE=quay.io/community-operator-pipeline-prod/percona-postgresql-operator@sha256:e791af86cd0baceb0475ecd6978ad5068180e58b1c500645acd00f1522edf8f0
IMAGE_TARGET=percona-postgresql-operator/3.0.0
IMAGE_FROM=docker.io/percona/percona-postgresql-operator:3.0.0
# Upstream skipRange is <3.0.0, which would let OLM upgrade 2.8.x straight to
# 3.0.0. Percona supports upgrading only to the nearest version, so only
# 2.9.x may move to 3.0.0 (upgrade path 2.8.2 -> 2.9.0 -> 3.0.0 -> 3.1.0).
SKIP_RANGE=>=2.9.0 <3.0.0
