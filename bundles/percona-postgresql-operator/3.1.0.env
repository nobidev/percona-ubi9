# Community catalog bundle of percona-postgresql-operator.v3.1.0, with the
# operator image (UBI 10 upstream) replaced by the UBI 9 rebuild.
MODE=rewrite
UPSTREAM_BUNDLE=quay.io/community-operator-pipeline-prod/percona-postgresql-operator@sha256:539d6eaaa94f480b95da161c5dc1a78eb0c44845d1d31f867e2715c1ce40d514
# Every occurrence of IMAGE_FROM in the bundle becomes
# ${REGISTRY}/<image>:<version> of IMAGE_TARGET (a versions/ target), by tag:
# the operator derives its init image from its own image reference.
IMAGE_TARGET=percona-postgresql-operator/3.1.0
IMAGE_FROM=docker.io/percona/percona-postgresql-operator:3.1.0
# Upstream skipRange is <3.1.0, which would let OLM upgrade 2.x straight to
# 3.1.0. Percona supports upgrading only to the nearest version, so only 3.0.x
# may move to 3.1.0 (upgrade path 2.8.2 -> 2.9.0 -> 3.0.0 -> 3.1.0).
SKIP_RANGE=>=3.0.0 <3.1.0
