# Community catalog bundle of percona-postgresql-operator.v2.9.0, with the
# operator image (UBI 10 upstream) replaced by the UBI 9 rebuild.
MODE=rewrite
UPSTREAM_BUNDLE=quay.io/community-operator-pipeline-prod/percona-postgresql-operator@sha256:ef6d9d08afd39f44898f7134388e5d4a95baf1873b227e28c298d156f22098df
IMAGE_TARGET=percona-postgresql-operator/2.9.0
IMAGE_FROM=docker.io/percona/percona-postgresql-operator:2.9.0
# Upstream skipRange is <v2.9.0 (normalized to <2.9.0), which would let a
# cluster at 2.8.0/2.8.1 skip 2.8.2. Percona supports upgrading only to the
# nearest version: only 2.8.2 (and later 2.8.x) may move to 2.9.0.
SKIP_RANGE=>=2.8.2 <2.9.0
